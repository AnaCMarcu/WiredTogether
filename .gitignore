runs/
runs_from_hpc/
runs_from_daic/

slurm_logs/

hpc/daic/slurm_*.out
hpc/daic/slurm_*.err

craftium/

# Claude Code local settings
.claude/

*.stackdump

hpc/delft_blue/analysis/out/

# LaTeX paper sources synced into the repo; not part of the code release.
wired_together_iclr2027*/
paper/

# Generated tables and figures. Every one is reproducible from analysis/.
paper_assets/

# Qualitative pipeline outputs: derived from the run logs, except the
# annotation labels, which are produced by an LLM annotator and kept.
analysis/qualitative/out/*
!analysis/qualitative/out/annotations/
analysis/qualitative/out_*/
