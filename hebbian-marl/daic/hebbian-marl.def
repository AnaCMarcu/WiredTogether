Bootstrap: docker
From: python:3.11-slim-bookworm

%labels
    Author Ana Marcu (acmarcu@tudelft.nl)
    Project hebbian-marl
    Description EPyMARL-derived MAPPO with Hebbian social plasticity on LBF. CPU-only.

%environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export OMP_NUM_THREADS=1
    export MKL_NUM_THREADS=1

%post
    set -eu

    export HOME=/tmp
    export PIP_ROOT_USER_ACTION=ignore

    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        build-essential
    rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip wheel setuptools

    # CPU-only torch (hebbian-marl runs on the general partition without GPU).
    pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.12.0 torchvision==0.27.0

    # hebbian-marl pinned deps (exactly mirrors hebbian-marl/pyproject.toml).
    pip install --no-cache-dir \
        numpy==1.26.4 \
        sacred==0.8.7 \
        PyYAML==6.0.3 \
        tensorboard-logger==0.1.0 \
        tensorboard \
        'pyparsing>=3.0' \
        probscale==0.2.5 \
        imageio==2.37.3 \
        matplotlib==3.10.9 \
        seaborn==0.13.2 \
        scipy==1.17.1 \
        Pillow==12.2.0 \
        pygame==2.6.1 \
        websocket-client==1.9.0 \
        wrapt==1.17.3 \
        absl-py==2.4.0 \
        attrs==26.1.0 \
        click==8.4.0 \
        pluggy==1.6.0 \
        portpicker==1.6.0 \
        requests==2.34.2 \
        tornado==6.5.5 \
        gymnasium==1.3.0 \
        lbforaging==2.0.0

%runscript
    exec "$@"

%help
    Apptainer image for hebbian-marl experiments on DAIC (CPU partition).
    Disjoint from wiredtogether.sif — incompatible gymnasium/torch pins.

    Build:
        sbatch hebbian-marl/daic/build_image.sbatch

    Run a tier (array):
        sbatch --array=0-4 hebbian-marl/daic/hebb_tier9.sbatch
